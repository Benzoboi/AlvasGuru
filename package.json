{
  "name": "sleep-watcher",
  "productName": "Sleep Watcher",
  "version": "0.1.0",
  "description": "Cross-platform sleep/motion/sound watcher with pre-buffered recording and local web UI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron .selftest",
    "test:capture": "electron .selftest --suite=capture-suite.js --use-fake-ui-for-media-stream --use-fake-device-for-media-stream",
    "test:stop": "electron .selftest --suite=stop-suite.js --use-fake-ui-for-media-stream --use-fake-device-for-media-stream",
    "test:schedule": "electron .selftest --suite=schedule-suite.js --use-fake-ui-for-media-stream --use-fake-device-for-media-stream",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.example.sleepwatcher",
    "productName": "Sleep Watcher",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Utility" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" }
  }
}
